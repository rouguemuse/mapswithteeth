# Maps With Teeth — Environment Configuration Template
# Copy this file to .env.local for local development, or add these keys to your hosting dashboard (e.g. Vercel)

# -------------------------------------------------------------
# 1. Stripe Payment Links (Universal "Customers Choose What to Pay")
# -------------------------------------------------------------
# Create these in your Stripe Dashboard -> Payment Links:
# https://dashboard.stripe.com/payment-links

# Link for One-Time contributions (choose "Customers choose what to pay" -> One-time)
NEXT_PUBLIC_STRIPE_ONETIME_URL=https://buy.stripe.com/your_onetime_payment_link

# Link for Monthly Sustaining contributions (choose "Customers choose what to pay" -> Recurring / Monthly)
NEXT_PUBLIC_STRIPE_MONTHLY_URL=https://buy.stripe.com/your_monthly_payment_link

# -------------------------------------------------------------
# Optional: Specific Tier Links (If you prefer fixed-amount links per tier)
# -------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_OT_25=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_OT_50=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_OT_100=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_OT_250=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_MO_10=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_MO_25=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_MO_50=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_MO_100=https://buy.stripe.com/...
